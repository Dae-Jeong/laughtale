APP_NAME=Laughtale Chat
APP_ENVIRONMENT=local
SERVICE_VERSION=0.1.0
SERVER_HOST=127.0.0.1
SERVER_PORT=18082
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=15
# Empty: foundation-only smoke, no DB connection. Set credentials locally.
# DB_PRIMARY_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5433/laughtale_chat
DB_PRIMARY_URL=
DB_POOL_SIZE=4
DB_POOL_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=2
DB_CONNECT_TIMEOUT_SECONDS=3
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=1000
